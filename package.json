{
  "name": "skeyes-desktop",
  "version": "1.0.0",
  "description": "Application desktop SKEYES - messagerie chiffree",
  "main": "main.js",
  "author": "SKEYES",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.skeyes.desktop",
    "productName": "SKEYES",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
